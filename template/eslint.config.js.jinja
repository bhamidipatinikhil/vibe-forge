// eslint.config.js — typed rules only; Biome owns formatting and syntactic lint

import { fixupPluginRules } from "@eslint/compat";
import vitest from "@vitest/eslint-plugin";
import { defineConfig } from "eslint/config";
import jsxA11y from "eslint-plugin-jsx-a11y";
import reactHooks from "eslint-plugin-react-hooks";
import regexp from "eslint-plugin-regexp";
import tseslint from "typescript-eslint";

// eslint-plugin-jsx-a11y 6.10.2 (the newest release) declares eslint <=9. fixupPluginRules supplies the context
// methods ESLint 10 removed, pnpm-workspace.yaml allows the peer, and tests/lint/jsx-a11y.test.ts proves the rules
// still report on this config. Drop the shim once a release supports ESLint 10.
const a11y = fixupPluginRules(jsxA11y);

export default defineConfig([
	// .stryker-tmp: a leftover Stryker sandbox holds a copy of tsconfig.json, which makes the project service fail on every
	// file ("multiple candidate TSConfigRootDirs are present"); the directory is git-ignored, so nothing else cleans it.
	// tests/lint/__fixtures__: deliberately broken code that tests/lint/*.test.ts lints with ignores off; tests/arch/__fixtures__:
	// deliberately forbidden imports that tests/arch/modules.test.ts cruises.
	{
		ignores: [
			"dist/**",
			"reports/**",
			"coverage/**",
			".stryker-tmp/**",
			"tests/lint/__fixtures__/**",
			"tests/arch/__fixtures__/**",
			"src/infra/db/schema.gen.ts",
{%- if kind == 'web' %}
			"src/ui/routeTree.gen.ts",
			"src/ui/paraglide/**",
			".content-collections/**",
			".tanstack/**",
{%- endif %}
		],
	},
	{
		files: ["**/*.{ts,tsx}"],
		extends: [tseslint.configs.strictTypeChecked, regexp.configs.recommended],
		languageOptions: { parserOptions: { projectService: true } },
		rules: {
			"@typescript-eslint/switch-exhaustiveness-check": "error",
			"@typescript-eslint/strict-boolean-expressions": "error",
			"@typescript-eslint/consistent-type-imports": "error",
			"@typescript-eslint/explicit-module-boundary-types": "error",
			"regexp/no-super-linear-backtracking": "error",
			"no-restricted-syntax": [
				"error",
				{
					selector: "CallExpression[callee.object.name='console']",
					message:
						"Use src/logger.ts (structured, redacted, trace-correlated).",
				},
			],
		},
	},
	{
		files: ["**/*.tsx"],
		plugins: { "jsx-a11y": a11y, "react-hooks": reactHooks },
		rules: {
			...jsxA11y.flatConfigs.strict.rules,
			...reactHooks.configs.flat.recommended.rules,
		},
	},
{%- if kind == 'web' %}
	{
		// TanStack Router infers route and router types end to end (the Register augmentation in routeTree.gen.ts);
		// annotating them by hand breaks that inference, so module-boundary annotations are not required here.
		files: ["src/ui/routes/**/*.tsx", "src/ui/router.tsx"],
		rules: {
			"@typescript-eslint/explicit-module-boundary-types": "off",
			// notFound() and redirect() are thrown by design: the router catches them.
			"@typescript-eslint/only-throw-error": [
				"error",
				{
					allow: [
						{
							from: "package",
							package: "@tanstack/router-core",
							name: ["NotFoundError", "Redirect"],
						},
					],
				},
			],
		},
	},
{%- endif %}
	{
		files: ["**/*.{test,spec}.ts?(x)"],
		plugins: { vitest },
		rules: {
			...vitest.configs.recommended.rules,
			// AGENTS.md promises "no .only/.skip". The recommended preset only warns on .skip, and a warning never fails
			// `eslint .`, so both are errors here.
			"vitest/no-disabled-tests": "error",
			"vitest/no-focused-tests": "error",
			"vitest/no-mocks-import": "error",
		},
	},
]);
