{
	"name": "{% if npm_scope %}@{{ npm_scope }}/{% endif %}{{ project_slug }}",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.27.0",
	"engines": {
		"node": ">={{ node_major }}"
	},
	"scripts": {
{%- if kind == 'web' %}
		"dev": "node --watch --import tsx --import ./src/instrumentation.ts scripts/dev.ts",
		"build": "tsx scripts/gen.ts && vite build && tsc -p tsconfig.build.json",
		"gen": "tsx scripts/gen.ts",
{%- else %}
		"dev": "node --import tsx --import ./src/instrumentation.ts --watch src/index.ts",
		"build": "tsc -p tsconfig.build.json",
{%- endif %}
		"dev:pretty": "pnpm run dev | pino-pretty",
		"start": "node --import ./dist/node/instrumentation.js dist/node/index.js",
		"test": "vitest run",
{%- if with_playwright %}
		"test:e2e": "playwright test",
{%- endif %}
		"test:mutation": "stryker run",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.build.json",
		"lint": "biome ci . && eslint . --max-warnings 0",
		"lint:ast": "ast-grep scan",
		"format": "biome format --write .",
		"arch": "depcruise src --config .dependency-cruiser.cjs",
		"dup": "jscpd",
		"deadcode": "knip",
		"docs": "typedoc",
		"openapi": "tsx scripts/emit-openapi.ts",
		"env:example": "tsx scripts/env-example.ts",
		"db": "tsx scripts/db.ts"
	},
	"dependencies": {
{%- if with_ai %}
		"@anthropic-ai/sdk": "1.3.0",
{%- endif %}
{%- if kind == 'web' %}
		"@base-ui/react": "1.9.0",
		"@fontsource/inter": "5.3.0",
{%- endif %}
		"@grpc/grpc-js": "1.14.7",
		"@hono/node-server": "2.1.5",
		"@hono/zod-openapi": "1.6.3",
		"@openfeature/core": "1.12.0",
		"@openfeature/flagd-provider": "0.18.0",
		"@openfeature/server-sdk": "1.23.0",
		"@opentelemetry/api": "1.10.0",
		"@opentelemetry/auto-instrumentations-node": "0.82.0",
		"@opentelemetry/exporter-metrics-otlp-http": "0.300.0",
		"@opentelemetry/exporter-trace-otlp-http": "0.300.0",
		"@opentelemetry/instrumentation": "0.300.0",
		"@opentelemetry/instrumentation-pino": "0.70.0",
		"@opentelemetry/sdk-metrics": "3.0.0",
		"@opentelemetry/sdk-node": "0.300.0",
{%- if payments == 'polar' %}
		"@polar-sh/sdk": "1.0.2",
{%- endif %}
		"@react-email/render": "2.2.0",
{%- if kind == 'web' %}
		"@resvg/resvg-wasm": "2.6.2",
{%- endif %}
		"@sentry/node": "11.10.0",
{%- if kind == 'web' %}
		"@sentry/react": "11.10.0",
{%- endif %}
		"@t3-oss/env-core": "0.13.11",
{%- if kind == 'web' %}
		"@tanstack/react-form": "1.33.5",
		"@tanstack/react-query": "5.105.0",
		"@tanstack/react-router": "1.170.46",
		"@tanstack/react-router-ssr-query": "1.167.3",
		"@tanstack/react-start": "1.169.4",
{%- endif %}
{%- if with_rich_text %}
		"@tiptap/pm": "3.32.2",
		"@tiptap/react": "3.32.2",
		"@tiptap/starter-kit": "3.32.2",
{%- endif %}
		"better-auth": "1.7.15",
{%- if kind == 'web' %}
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
{%- endif %}
		"hono": "4.13.14",
		"kysely": "0.29.7",
{%- if with_charts %}
		"lightweight-charts": "5.2.1",
{%- endif %}
{%- if kind == 'web' %}
		"lucide-react": "1.65.0",
{%- endif %}
		"neverthrow": "8.2.0",
		"pg": "8.23.1",
		"pg-boss": "12.38.0",
		"pino": "10.4.0",
{%- if payments == 'razorpay' %}
		"razorpay": "2.9.8",
{%- endif %}
		"react": "19.3.1",
{%- if kind == 'web' %}
		"react-aria-components": "1.22.1",
{%- endif %}
		"react-dom": "19.3.1",
		"react-email": "6.11.6",
{%- if with_charts %}
		"react-is": "19.3.1",
		"recharts": "3.10.1",
{%- endif %}
		"resend": "6.35.0",
{%- if kind == 'web' %}
		"satori": "0.63.2",
		"tailwind-merge": "3.7.0",
		"web-vitals": "6.2.3",
{%- endif %}
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@ast-grep/cli": "0.51.0",
{%- if with_playwright %}
		"@axe-core/playwright": "4.14.0",
{%- endif %}
		"@biomejs/biome": "2.6.3",
		"@changesets/cli": "3.0.3",
		"@commitlint/cli": "21.2.4",
		"@commitlint/config-conventional": "21.2.4",
{%- if kind == 'web' %}
		"@content-collections/core": "0.15.3",
		"@content-collections/vite": "0.3.1",
{%- endif %}
		"@eslint/compat": "2.1.1",
		"@fast-check/vitest": "0.5.0",
{%- if kind == 'web' %}
		"@inlang/paraglide-js": "2.29.3",
		"@inlang/plugin-message-format": "4.5.6",
		"@lhci/cli": "0.15.1",
		"@mdx-js/rollup": "3.1.1",
{%- endif %}
{%- if with_playwright %}
		"@playwright/test": "1.59.1",
{%- endif %}
{%- if kind == 'web' %}
		"@size-limit/file": "14.3.0",
{%- endif %}
		"@stryker-mutator/core": "10.1.1",
		"@stryker-mutator/vitest-runner": "10.1.1",
{%- if kind == 'web' %}
		"@tailwindcss/vite": "4.3.3",
{%- endif %}
		"@total-typescript/ts-reset": "0.6.1",
{%- if kind == 'web' %}
		"@types/mdx": "2.0.14",
{%- endif %}
		"@types/node": "{% if node_major == 26 %}26.6.5{% else %}24.19.2{% endif %}",
		"@types/pg": "8.23.1",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
{%- if kind == 'web' %}
		"@vitejs/plugin-react": "6.1.2",
		"@vitest/browser-playwright": "5.0.5",
{%- endif %}
		"@vitest/coverage-v8": "5.0.5",
		"@vitest/eslint-plugin": "1.6.28",
		"dependency-cruiser": "18.7.0",
		"eslint": "10.13.0",
		"eslint-plugin-jsx-a11y": "6.10.2",
		"eslint-plugin-react-hooks": "7.1.1",
		"eslint-plugin-regexp": "3.3.1",
		"fast-check": "4.10.2",
		"jscpd": "5.4.2",
		"knip": "6.43.0",
		"kysely-codegen": "0.20.0",
		"msw": "3.0.3",
		"pino-pretty": "13.2.0",
{%- if kind == 'web' %}
		"playwright": "1.59.1",
		"schema-dts": "2.1.0",
		"size-limit": "14.3.0",
		"tailwindcss": "4.3.3",
{%- endif %}
		"tsx": "4.23.15",
		"typedoc": "0.28.20",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.1",
{%- if kind == 'web' %}
		"vite": "8.3.5",
{%- endif %}
		"vitest": "5.0.5"{% if kind == 'web' %},
		"vitest-browser-react": "2.3.0"{% endif %}
	}
}
