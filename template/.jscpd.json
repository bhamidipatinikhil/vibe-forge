{
	"threshold": 3,
	"minTokens": 50,
	"minLines": 5,
	"format": ["typescript", "tsx", "javascript"],
	"ignore": [
		"**/node_modules/**",
		"**/dist/**",
		"**/*.{test,spec}.{ts,tsx}",
		"**/__fixtures__/**",
		"**/schema.gen.ts",
		"**/routeTree.gen.ts",
		"**/paraglide/**",
		"**/components/ui/**"
	],
	"reporters": ["console", "json"],
	"output": "reports/jscpd"
}
