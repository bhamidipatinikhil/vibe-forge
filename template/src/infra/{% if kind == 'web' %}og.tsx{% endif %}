import { readFile } from "node:fs/promises";
import { createRequire } from "node:module";
import { initWasm, Resvg } from "@resvg/resvg-wasm";
import satori from "satori";
import type { OgRenderer } from "../app/routes/og.js";

const require = createRequire(import.meta.url);

interface Assets {
	readonly font: Buffer;
}

let assets: Promise<Assets> | undefined;

/** Loads the resvg WebAssembly module and the font once, on first use. */
async function loadAssets(): Promise<Assets> {
	await initWasm(
		await readFile(require.resolve("@resvg/resvg-wasm/index_bg.wasm")),
	);
	// satori reads TTF, OTF and WOFF (not WOFF2); @fontsource ships WOFF next to WOFF2.
	const font = await readFile(
		require.resolve("@fontsource/inter/files/inter-latin-700-normal.woff"),
	);
	return { font };
}

/**
 * Open Graph images: a title on a plain card, laid out by satori (JSX to SVG)
 * and rasterized by resvg (SVG to PNG), both in-process.
 */
export const ogRenderer: OgRenderer = {
	render: async (title) => {
		assets ??= loadAssets();
		const { font } = await assets;
		const svg = await satori(
			<div
				style={{
					display: "flex",
					width: "100%",
					height: "100%",
					padding: "80px",
					alignItems: "flex-end",
					background: "#0f172a",
					color: "#f8fafc",
					fontSize: 72,
					fontFamily: "Inter",
				}}
			>
				{title}
			</div>,
			{
				width: 1200,
				height: 630,
				fonts: [{ name: "Inter", data: font, weight: 700, style: "normal" }],
			},
		);
		return new Uint8Array(new Resvg(svg).render().asPng());
	},
};
