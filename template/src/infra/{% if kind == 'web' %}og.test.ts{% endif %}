import { describe, expect, it } from "vitest";
import { ogRenderer } from "./og.js";

const PNG_SIGNATURE = [0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a];

describe("ogRenderer", () => {
	it("renders a PNG for a title (satori, then resvg), reusing the loaded font", async () => {
		const first = await ogRenderer.render("Hello, World");
		const second = await ogRenderer.render("Again");
		expect([...first.slice(0, 8)]).toEqual(PNG_SIGNATURE);
		expect(second.length).toBeGreaterThan(1000);
	});
});
