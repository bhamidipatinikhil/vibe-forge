import { createHmac } from "node:crypto";
import { describe, expect, it, vi } from "vitest";
import { createApp } from "../app/app.js";
import { webhookVerifier } from "./payments.js";

vi.hoisted(() => {
	vi.stubEnv("LOG_LEVEL", "silent");
});

const SECRET = "whsec_test_secret_value";
const PATH = "/api/v1/webhooks/{{ payments }}";
{%- if payments == 'razorpay' %}
const body = JSON.stringify({ event: "payment.captured", payload: {} });

/** Razorpay signs the raw body: HMAC-SHA256 with the webhook secret, hex. */
function sign(secret: string): Record<string, string> {
	const signature = createHmac("sha256", secret).update(body).digest("hex");
	return { "x-razorpay-signature": signature };
}
{%- else %}
const body = JSON.stringify({
	type: "order.paid",
	timestamp: new Date().toISOString(),
	data: {},
});

/** Standard Webhooks headers (Polar signs with the UTF-8 bytes of the secret). */
function sign(secret: string): Record<string, string> {
	const id = "msg_1";
	const timestamp = String(Math.floor(Date.now() / 1000));
	const signature = createHmac("sha256", Buffer.from(secret, "utf8"))
		.update(`${id}.${timestamp}.${body}`)
		.digest("base64");
	return {
		"webhook-id": id,
		"webhook-timestamp": timestamp,
		"webhook-signature": `v1,${signature}`,
	};
}
{%- endif %}

function post(
	app: ReturnType<typeof createApp>,
	headers: Record<string, string>,
): Promise<Response> {
	return Promise.resolve(
		app.request(PATH, {
			method: "POST",
			headers: { "content-type": "application/json", ...headers },
			body,
		}),
	);
}

describe("POST {{ '/api/v1/webhooks/' ~ payments }}", () => {
	const app = createApp(webhookVerifier(SECRET));
{%- if payments == 'razorpay' %}

	it("accepts a delivery signed with the webhook secret", async () => {
		const response = await post(app, sign(SECRET));
		expect(response.status).toBe(200);
		expect(await response.json()).toEqual({ received: true });
	});
{%- endif %}

	it("rejects a delivery signed with another secret, or not signed at all, with 401", async () => {
		expect((await post(app, sign("another-secret"))).status).toBe(401);
		expect((await post(app, {})).status).toBe(401);
	});

	it("answers 503 while no webhook secret is configured", async () => {
		const unconfigured = createApp(webhookVerifier(undefined));
		expect((await post(unconfigured, sign(SECRET))).status).toBe(503);
	});
});
