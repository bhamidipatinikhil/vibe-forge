import { createEnv } from "@t3-oss/env-core";
import { z } from "zod";

const { SKIP_ENV_VALIDATION, NODE_ENV } = process.env;

/** Production refuses the local-only defaults below (database URL, auth secret). */
const production = NODE_ENV === "production";

/** The project's names, from .copier-answers.yml. */
const PROJECT = {
	slug: "{{ project_slug }}",
	name: "{{ project_name }}",
};

/** Local cluster started by `just db-up` (TCP on 127.0.0.1, see scripts/lib/ephemeral-pg.ts). */
const LOCAL_DATABASE_URL = `postgres://postgres@127.0.0.1:54329/${PROJECT.slug.replaceAll("-", "_")}?sslmode=disable`;

/** Development-only signing secret; production must set its own (32+ random characters). */
const LOCAL_AUTH_SECRET = "local-development-secret-not-for-production-use";

const optionalUrl = z.url().optional();

/**
 * Schema of every server-side environment variable. `scripts/env-example.ts`
 * renders `.env.example` from it (description and example come from `.meta`),
 * and `just docs` fails when the committed file drifts.
 */
export const serverSchema = {
	PORT: z.coerce.number().int().min(0).max(65535).default(3000).meta({
		description: "TCP port the HTTP server binds (0 picks a free port)",
		example: "3000",
	}),
	HOST: z.string().min(1).default("127.0.0.1").meta({
		description:
			"Interface the HTTP server binds; the Dockerfile sets 0.0.0.0, everything else stays on loopback",
		example: "127.0.0.1",
	}),
	NODE_ENV: z
		.enum(["development", "test", "production"])
		.default("development")
		.meta({
			description: "development | test | production",
			example: "development",
		}),
	LOG_LEVEL: z
		.enum(["fatal", "error", "warn", "info", "debug", "trace", "silent"])
		.default("info")
		.meta({
			description:
				"Pino level: trace | debug | info | warn | error | fatal | silent",
			example: "info",
		}),
	APP_URL: z.url().default("http://127.0.0.1:3000").meta({
		description:
			"Public origin of the app: auth callbacks, email links, the CSRF origin check",
		example: "http://127.0.0.1:3000",
	}),
	DATABASE_URL: (production
		? z.url()
		: z.url().default(LOCAL_DATABASE_URL)
	).meta({
		description:
			"Postgres connection URL; required in production (Neon: the pooled URL with sslmode=require)",
		example: LOCAL_DATABASE_URL,
	}),
	DATABASE_POOL_MAX: z.coerce.number().int().min(1).max(100).default(10).meta({
		description: "Connections in the pool shared by Kysely and better-auth",
		example: "10",
	}),
	BETTER_AUTH_SECRET: (production
		? z.string().min(32)
		: z.string().min(32).default(LOCAL_AUTH_SECRET)
	).meta({
		description:
			"Session signing secret, 32+ random characters (openssl rand -base64 32); required in production",
		example: "",
	}),
	BODY_LIMIT_BYTES: z.coerce.number().int().min(1024).default(1_048_576).meta({
		description: "Largest accepted request body on /api/* in bytes",
		example: "1048576",
	}),
	EMAIL_FROM: z
		.string()
		.min(3)
		.default(`${PROJECT.name} <noreply@example.com>`)
		.meta({
			description:
				"Sender of transactional email (a domain verified in Resend in production)",
			example: `${PROJECT.name} <noreply@example.com>`,
		}),
	RESEND_API_KEY: z.string().min(1).optional().meta({
		description:
			"Resend API key; when unset, mail goes to Mailpit (MAILPIT_URL) or, outside production, to the log",
		example: "",
	}),
	MAILPIT_URL: optionalUrl.meta({
		description:
			"Mailpit base URL for local mail (just mail), e.g. http://127.0.0.1:8025",
		example: "",
	}),
	FLAGS_FILE: z.string().min(1).default("flags/flags.json").meta({
		description:
			"flagd flag definitions read in-process by OpenFeature (kill switches live here)",
		example: "flags/flags.json",
	}),
	JOBS_ENABLED: z.stringbool().default(true).meta({
		description: "Run pg-boss workers and cron schedules in this process",
		example: "true",
	}),
	SENTRY_DSN: optionalUrl.meta({
		description:
			"Sentry DSN for error reports; unset keeps errors in the log only",
		example: "",
	}),
	SENTRY_RELEASE: z.string().min(1).optional().meta({
		description: "Release name attached to Sentry events, e.g. the git SHA",
		example: "",
	}),
	OTEL_SERVICE_NAME: z.string().min(1).default(PROJECT.slug).meta({
		description: "service.name on every trace, metric and log record",
		example: PROJECT.slug,
	}),
	OTEL_EXPORTER_OTLP_ENDPOINT: optionalUrl.meta({
		description:
			"OTLP/HTTP collector base URL (Grafana Cloud: https://otlp-gateway-<zone>.grafana.net/otlp); the auth header goes in OTEL_EXPORTER_OTLP_HEADERS in your secret store",
		example: "",
	}),
{%- if kind == 'web' %}
	CSP_CONNECT_SRC: z.string().default("").meta({
		description:
			"Extra comma-separated origins for the CSP connect-src (Sentry ingest, Umami), e.g. https://o1.ingest.sentry.io",
		example: "",
	}),
{%- endif %}
{%- if payments == 'razorpay' %}
	RAZORPAY_KEY_ID: z.string().min(1).optional().meta({
		description: "Razorpay key id (rzp_test_... in test mode)",
		example: "",
	}),
	RAZORPAY_KEY_SECRET: z.string().min(1).optional().meta({
		description: "Razorpay key secret",
		example: "",
	}),
	RAZORPAY_WEBHOOK_SECRET: z.string().min(1).optional().meta({
		description:
			"Secret of the Razorpay webhook; unset makes POST /api/v1/webhooks/razorpay answer 503",
		example: "",
	}),
{%- endif %}
{%- if payments == 'polar' %}
	POLAR_ACCESS_TOKEN: z.string().min(1).optional().meta({
		description: "Polar organization access token",
		example: "",
	}),
	POLAR_SERVER: z.enum(["sandbox", "production"]).default("sandbox").meta({
		description: "Polar API environment: sandbox | production",
		example: "sandbox",
	}),
	POLAR_WEBHOOK_SECRET: z.string().min(1).optional().meta({
		description:
			"Secret of the Polar webhook endpoint; unset makes POST /api/v1/webhooks/polar answer 503",
		example: "",
	}),
{%- endif %}
{%- if with_ai %}
	ANTHROPIC_API_KEY: z.string().min(1).optional().meta({
		description:
			"Anthropic API key; unset makes POST /api/v1/ai/summarize answer 503",
		example: "",
	}),
	ANTHROPIC_MODEL: z.string().min(1).default("claude-opus-5-5").meta({
		description: "Claude model id used by the AI routes",
		example: "claude-opus-5-5",
	}),
{%- endif %}
};

/**
 * Validated process environment. Importing this module fails fast on an
 * invalid configuration unless `SKIP_ENV_VALIDATION` is set (secret-less
 * Docker or CI builds). `.env.example` is generated from {@link serverSchema}.
 */
export const env = createEnv({
	server: serverSchema,
	runtimeEnv: process.env,
	emptyStringAsUndefined: true,
	skipValidation: Boolean(SKIP_ENV_VALIDATION),
});
