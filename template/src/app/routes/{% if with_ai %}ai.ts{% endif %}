import { createRoute, z } from "@hono/zod-openapi";
import type { Result } from "neverthrow";
import { ErrorResponseSchema } from "../../schemas/error.js";
import type { App, AuthPort } from "../ports.js";
import { requireSession } from "../session.js";

/** Why a summary could not be produced. */
export interface SummarizeError {
	/** `refused`: the model declined; `busy`: rate limited; `upstream`: any other API failure. */
	readonly kind: "refused" | "busy" | "upstream";
}

/** Summarizes text with Claude (src/infra/ai.ts). */
export interface Summarizer {
	/**
	 * Summarizes `text` in at most three sentences.
	 * @param text - Input, already validated (1 to 20 000 characters).
	 */
	readonly summarize: (text: string) => Promise<Result<string, SummarizeError>>;
}

const SummarizeBodySchema = z
	.object({
		text: z
			.string()
			.min(1)
			.max(20_000)
			.openapi({ example: "Long article text..." }),
	})
	.openapi("SummarizeBody");

const SummaryResponseSchema = z
	.object({ summary: z.string().openapi({ example: "A short summary." }) })
	.openapi("Summary");

const error = (description: string) => ({
	description,
	content: { "application/json": { schema: ErrorResponseSchema } },
});

/**
 * `POST /api/v1/ai/summarize`; `requireSession` answers anonymous callers with 401 before the body is validated.
 * @param auth - The session lookup.
 */
function summarizeRoute(auth: AuthPort) {
	return createRoute({
		method: "post",
		path: "/api/v1/ai/summarize",
		tags: ["ai"],
		summary: "Summarize text with Claude (signed-in users only)",
		middleware: [requireSession(auth)] as const,
		request: {
			body: {
				content: { "application/json": { schema: SummarizeBodySchema } },
				required: true,
			},
		},
		responses: {
			200: {
				description: "The summary",
				content: { "application/json": { schema: SummaryResponseSchema } },
			},
			400: error("Missing or too long text"),
			401: error("Not signed in"),
			422: error("The model declined to summarize this text"),
			503: error("AI is not configured, or the provider is unavailable"),
		},
	});
}

const STATUS = { refused: 422, busy: 503, upstream: 503 } as const;

/**
 * Registers `POST /api/v1/ai/summarize`.
 * @param app - The application.
 * @param auth - Session lookup; anonymous callers get 401.
 * @param ai - The summarizer; without it the route answers 503.
 */
export function registerAiRoutes(
	app: App,
	auth: AuthPort,
	ai: Summarizer | undefined,
): void {
	app.openapi(summarizeRoute(auth), async (c) => {
		if (ai === undefined) {
			return c.json(
				{ error: { code: "unavailable", message: "AI is not configured" } },
				503,
			);
		}
		const result = await ai.summarize(c.req.valid("json").text);
		if (result.isOk()) {
			return c.json({ summary: result.value }, 200);
		}
		const status = STATUS[result.error.kind];
		return c.json(
			{
				error: { code: result.error.kind, message: "No summary was produced" },
			},
			status,
		);
	});
}
