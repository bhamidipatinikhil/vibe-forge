import { createRoute, z } from "@hono/zod-openapi";
import { metrics } from "@opentelemetry/api";
import { ErrorResponseSchema } from "../../schemas/error.js";
import type { App } from "../ports.js";

/** One Core Web Vitals measurement, as `web-vitals` reports it (src/ui/client.tsx). */
const VitalSchema = z
	.object({
		name: z.enum(["CLS", "FCP", "INP", "LCP", "TTFB"]),
		value: z.number().nonnegative().max(600_000),
		rating: z.enum(["good", "needs-improvement", "poor"]),
		path: z.string().max(2048).openapi({ example: "/" }),
	})
	.openapi("WebVital");

const vitalsRoute = createRoute({
	method: "post",
	path: "/api/v1/vitals",
	tags: ["web"],
	summary: "Real-user Core Web Vitals (sent with navigator.sendBeacon)",
	request: {
		body: {
			content: { "application/json": { schema: VitalSchema } },
			required: true,
		},
	},
	responses: {
		204: { description: "Recorded" },
		400: {
			description: "Not a web-vitals measurement",
			content: { "application/json": { schema: ErrorResponseSchema } },
		},
	},
});

const meter = metrics.getMeter("app.web-vitals");
const vitals = meter.createHistogram("web_vitals", {
	description:
		"Core Web Vitals reported by browsers (CLS is unitless, the rest milliseconds)",
});

/**
 * Registers `POST /api/v1/vitals`: each measurement becomes an OpenTelemetry
 * histogram sample (`web_vitals{name,rating}`), exported with the other
 * metrics when a collector is configured (Grafana: RUM next to the traces).
 * @param app - The application.
 */
export function registerVitalsRoute(app: App): void {
	app.openapi(vitalsRoute, (c) => {
		const vital = c.req.valid("json");
		vitals.record(vital.value, { name: vital.name, rating: vital.rating });
		return c.body(null, 204);
	});
}
