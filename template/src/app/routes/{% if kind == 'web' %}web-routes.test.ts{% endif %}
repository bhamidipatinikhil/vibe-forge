import { describe, expect, it, vi } from "vitest";
import { createApp } from "../app.js";

vi.hoisted(() => {
	vi.stubEnv("LOG_LEVEL", "silent");
});

describe("GET /api/v1/og", () => {
	it("answers the renderer's PNG with a day of caching", async () => {
		const png = new Uint8Array([0x89, 0x50, 0x4e, 0x47]);
		const app = createApp({ og: { render: () => Promise.resolve(png) } });
		const response = await app.request("/api/v1/og?title=Hello");
		expect(response.status).toBe(200);
		expect(response.headers.get("content-type")).toBe("image/png");
		expect(response.headers.get("cache-control")).toBe("public, max-age=86400");
		expect(new Uint8Array(await response.arrayBuffer())).toEqual(png);
	});

	it("validates the title and answers 503 without a renderer", async () => {
		const app = createApp();
		expect((await app.request("/api/v1/og")).status).toBe(400);
		expect((await app.request("/api/v1/og?title=Hello")).status).toBe(503);
	});
});

describe("POST /api/v1/vitals", () => {
	const post = (body: unknown) =>
		createApp().request("/api/v1/vitals", {
			method: "POST",
			headers: { "content-type": "application/json" },
			body: JSON.stringify(body),
		});

	it("records a measurement", async () => {
		const response = await post({
			name: "LCP",
			value: 1234.5,
			rating: "good",
			path: "/",
		});
		expect(response.status).toBe(204);
	});

	it("rejects anything that is not a web-vitals measurement", async () => {
		expect(
			(await post({ name: "FID", value: 1, rating: "good", path: "/" })).status,
		).toBe(400);
		expect(
			(await post({ name: "LCP", value: -1, rating: "good", path: "/" }))
				.status,
		).toBe(400);
	});
});
