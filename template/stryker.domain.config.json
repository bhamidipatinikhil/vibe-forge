{
	"$comment": "Second Stryker run for src/domain only: the core logic is held to break 80 (the default run keeps 60 for everything). Run by `just mutation` after stryker.config.json.",
	"testRunner": "vitest",
	"plugins": ["@stryker-mutator/vitest-runner"],
	"vitest": { "configFile": "vitest.unit.config.ts", "related": true },
	"coverageAnalysis": "perTest",
	"ignoreStatic": true,
	"mutate": ["src/domain/**/*.ts", "!src/domain/**/*.{test,spec}.ts"],
	"incremental": true,
	"incrementalFile": "reports/stryker-domain-incremental.json",
	"thresholds": { "high": 90, "low": 80, "break": 80 },
	"reporters": ["clear-text", "progress"],
	"concurrency": "50%"
}
