{
	"$schema": "https://typedoc.org/schema.json",
	"entryPoints": ["src/index.ts"],
	"out": "reports/typedoc",
	"excludePrivate": true,
	"excludeExternals": true,
	"validation": {
		"notExported": true,
		"invalidLink": true,
		"notDocumented": true
	},
	"treatValidationWarningsAsErrors": true,
	"intentionallyNotDocumented": []
}
